APP_HOST=0.0.0.0
APP_PORT=48765
APP_MODE=offline

# GCE 배포: APP_MODE=db 이면 Secret Manager 의 DB_* 시크릿을 읽습니다.
# 프로젝트 ID를 비우면 GCE/ADC 에서 자동으로 찾습니다.
GCP_PROJECT_ID=
SECRETS_SOURCE=auto

# 로컬에서만 채웁니다. 배포 서버에서는 Secret Manager 값을 우선합니다.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

MODEL_DIR=models

# 학급 경제지표(economic_metric) 스냅샷 주기. 0이면 API 기동 시 자동 갱신을 끕니다.
METRIC_INTERVAL_SECONDS=0
